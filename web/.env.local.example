# Copy to .env.local (never commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (admin: create users). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only for scripts/run-sql.mjs (Supabase > Connect > Session pooler URI). Not used by the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
